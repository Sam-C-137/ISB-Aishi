    "locales": {
      "en": {
        "name": "First Spear Siege-R Optimized M.A.S.S. Plate Carrier (ISB STF-A Edition)",
        "shortName": "Siege-R ISBE V2",
        "description": "A Siege-R Optimized plate carrier equipped with the M.A.S.S. Shoulder System. Provides reliable all-around protection while offering ample workspace for equipment placement. Special edition for the Apex Squadron leader, Loghan of ISB SOF."
      },
        "po": {
        "name": "Colete Tático First Spear Siege-R Optimized M.A.S.S. (Edição ISB STF-A)",
        "shortName": "Siege-R EISB V2",
        "description": "Um porta-placas otimizado para cerco, equipado com o sistema de ombro M.A.S.S. Oferece proteção confiável em todas as direções, ao mesmo tempo em que proporciona amplo espaço de trabalho para a colocação de equipamentos. Versão especial para o líder do esquadrão Apex, Loghan da ISB SOF."
      },
      "ru": {
        "name": "Улучшенный чехол для бронеплит First Spear \"Siege-R Optimized M.A.S.S.\" (ISB STF-A Edition)",
        "shortName": "Siege-R ISBE V2",
        "description": "Комплект, состоящий из обновлённой версии жилета Siege-R Optimized и системы M.A.S.S. Shoulder System. Обеспечивает надёжную круговую защиту и достаточный объём рабочего пространства для хранения снаряжения. Специальное издание для Логана, лидера эскадрона Apex из спецназа ISB."
      }
    },

