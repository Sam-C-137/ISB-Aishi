    "locales": {
      "en": {
        "name": "Champion's helmet (ISB STF-A Edition)",
        "shortName": "Champion",
        "description": "A helmet whose history traces back to one of the Arena’s greatest gladiators, who was defeated in combat by an unknown challenger. The helmet was recovered in battle and modified with new ornaments and special textured armor for Apex Squadron leader Loghan of ISB SOF."
      },
        "po": {
        "name": "Capacete do Campeão (Edição ISB STF-A)",
        "shortName": "Campeão",
        "description": "Um capacete cuja as histórias remetem a um dos melhores gladiadores da Arena derrotado em combate por um desafiante desconhecido. Seu capacete foi recuperado em combate, modificado com novos ornamentos e blindagem texturizada especial para o líder do esquadrão Apex, Loghan da ISB SOF."
      },
      "ru": {
        "name": "Шлем Чемпиона (ISB STF-A Edition)",
        "shortName": "Чемпион",
        "description": "Шлем, история которого восходит к одному из величайших гладиаторов Арены, побеждённому в бою неизвестным претендентом. Шлем был восстановлен в бою и модифицирован новыми орнаментами и специальной текстурированной бронёй для Логана, лидера эскадрона Apex из спецназа ISB."
      }
    },

