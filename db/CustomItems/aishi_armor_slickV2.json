      "en": {
        "name": "Custom ISB SOF LBT-6094A Slick Plate Carrier (ISB STF-A Edition)",
        "shortName": "ISB Slick V2",
        "description": "A simple yet effective plate carrier by London Bridge Trading company and modified by ISB. The most minimalistic design intended for use with chest rigs. Designed for Vipper, the leader of the Snake squadron, from ISB SOF."
      },
        "po": {
        "name": "Colete LBT-6094A Slick (ISB STF-A Edition) Modificado das Forças Especiais da ISB",
        "shortName": "Slick da ISB V2",
        "description": "Um colete de placas simples, mas eficaz, fabricado pela London Bridge Trading e modificado pela ISB. O design mais minimalista, concebido para uso com arneses de peito. Projetado para Vipper, o líder do esquadrão Snake, da ISB."
      },
      "ru": {
        "name": "Кастомный пластинчатый бронежилет LBT-6094A Slick (ISB STF-A Edition) от спецназа ISB",
        "shortName": "ISB Slick V2",
        "description": "Простой, но эффективный пластинчатый бронежилет от компании London Bridge Trading, модифицированный ISB. Максимально минималистичный дизайн, предназначенный для использования с нагрудными разгрузочными системами. Разработан для Виппера, лидера эскадрона Snake, из спецназа ISB."
      }
