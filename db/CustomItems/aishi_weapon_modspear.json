    "locales": {
      "en": {
          "name": "Modified SIG MCX-SPEAR 6.8x51 assault rifle",
          "shortName": "MOD-SPEAR 6.8x51mm",
          "description": "The MCX SPEAR is a multi-caliber assault rifle designed and manufactured by SIG Sauer based on the MCX assault rifle. Primarily chambered in the new 6.8x51mm (.277 FURY) ammunition. Designed specifically for the US Military to replace the M4 carbine."
      },
      "po": {
          "name": "Rifle de assalto SIG MCX SPEAR 6.8x51 modificado",
          "shortName": "MOD-SPEAR 6.8x51mm",
          "description": "A MCX SPEAR é um fuzil de assalto multicalibre projetado e fabricado pela SIG Sauer com base no fuzil de assalto MCX. Utiliza principalmente a nova munição 6,8x51 mm (.277 FURY). Foi projetada especificamente para as Forças Armadas dos EUA com o objetivo de substituir a carabina M4."
      },
      "ru": {
        "name": "Модифицированная штурмовая винтовка SIG MCX-SPEAR 6.8x51",
        "shortName": "MOD-SPEAR 6.8x51мм",
        "description": "MCX-SPEAR - мультикалиберная штурмовая винтовка, разработанная на базе винтовки MCX и выпускаемая компанией SIG Sauer. Базовый калибр - 6.8х51мм (.277 FURY). Разработан специально для вооруженных сил США в качестве замены карабину M4."
      }
