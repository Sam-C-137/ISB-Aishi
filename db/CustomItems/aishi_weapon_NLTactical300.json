    "locales": {
      "en": {
          "name": "NL15 Tactical .300 Blackout Assault Rifle (Prototype)",
          "shortName": "NL15 Rifle",
          "description": "A custom assault rifle based on the AR-15 platform, designed to combine modern ergonomics, high modularity, and the performance of the .300 Blackout cartridge in close- to medium-range combat. Manufactured by Custom Guns, the NL15 features a bolt assembly and gas system tuned to provide reliable operation with both subsonic and supersonic ammunition, especially in configurations with a suppressor."
      },
      "po": {
          "name": "NL15 Tactical .300 Blackout Assault Rifle (Prototype)",
          "shortName": "NL15 Rifle",
          "description": "Um fuzil de assalto customizado baseado na plataforma AR-15, projetado para combinar ergonomia moderna, alta modularidade e o desempenho do cartucho .300 Blackout em combates de curta a média distância. Fabricado pela Custom Guns, o NL15 utiliza um conjunto de ferrolho e sistema de gases ajustado para oferecer funcionamento confiável tanto com munições subsônicas quanto supersônicas, especialmente em configurações com supressor."
      },
      "ru": {
        "name": "Штурмовая винтовка NL15 Tactical .300 Blackout (Прототип)",
        "shortName": "NL15",
        "description": "Кастомная штурмовая винтовка на базе платформы AR-15, разработанная для сочетания современной эргономики, высокой модульности и эффективности патрона .300 Blackout в ближнем и среднем бою. Производства Custom Guns, NL15 оснащена затворной группой и газовой системой, настроенными для надёжной работы как с дозвуковыми, так и со сверхзвуковыми боеприпасами, особенно в конфигурациях с глушителем."
      }
    },

