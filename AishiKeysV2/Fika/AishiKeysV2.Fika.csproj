<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>AishiKeysV2.Fika</AssemblyName>
    <RootNamespace>AishiKeys.Fika</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0</FileVersion>

    <SPTRoot Condition="'$(SPTRoot)' == ''">C:\SPTV</SPTRoot>
    <ManagedPath>$(SPTRoot)\EscapeFromTarkov_Data\Managed</ManagedPath>
    <BepInExCore>$(SPTRoot)\BepInEx\core</BepInExCore>
    <BepInExPlugins>$(SPTRoot)\BepInEx\plugins</BepInExPlugins>

    <FikaCorePath Condition="'$(FikaCorePath)' == '' and Exists('$(BepInExPlugins)\Fika\Fika.Core.dll')">$(BepInExPlugins)\Fika\Fika.Core.dll</FikaCorePath>
    <FikaCorePath Condition="'$(FikaCorePath)' == '' and Exists('$(BepInExPlugins)\Fika.Core.dll')">$(BepInExPlugins)\Fika.Core.dll</FikaCorePath>
    <FikaCorePath Condition="'$(FikaCorePath)' == '' and Exists('$(BepInExPlugins)\Fika\Core\Fika.Core.dll')">$(BepInExPlugins)\Fika\Core\Fika.Core.dll</FikaCorePath>
    <FikaCorePath Condition="'$(FikaCorePath)' == '' and Exists('$(SPTRoot)\Fika.Core.dll')">$(SPTRoot)\Fika.Core.dll</FikaCorePath>
    <FikaCorePath Condition="'$(FikaCorePath)' == '' and Exists('$(MSBuildThisFileDirectory)Ref\Fika.Core.dll')">$(MSBuildThisFileDirectory)Ref\Fika.Core.dll</FikaCorePath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AishiKeysFikaBootstrap.cs" />
    <Compile Include="AishiKeysPacket.cs" />
    <Compile Include="FikaAishiKeysNetworkBridge.cs" />
    <Compile Include="FikaWorldInteractionKeyPatch.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AishiKeysV2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ItemComponent.Types">
      <HintPath>$(ManagedPath)\ItemComponent.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(ManagedPath)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fika.Core">
      <HintPath>$(FikaCorePath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ResolveFikaCorePath" BeforeTargets="ResolveReferences" Condition="'$(FikaCorePath)' == ''">
    <ItemGroup>
      <FikaCoreCandidate Include="$(BepInExPlugins)\**\Fika.Core.dll" />
    </ItemGroup>
    <PropertyGroup Condition="'@(FikaCoreCandidate)' != ''">
      <FikaCorePath>@(FikaCoreCandidate->'%(FullPath)')</FikaCorePath>
    </PropertyGroup>
    <ItemGroup Condition="'$(FikaCorePath)' != ''">
      <Reference Update="Fika.Core">
        <HintPath>$(FikaCorePath)</HintPath>
      </Reference>
    </ItemGroup>
  </Target>
  <Target Name="ValidateFikaCore" BeforeTargets="ResolveReferences" DependsOnTargets="ResolveFikaCorePath">
    <Error Condition="'$(FikaCorePath)' == ''" Text="Fika.Core.dll was not found under $(BepInExPlugins). Set SPTRoot to your SPT folder or pass /p:FikaCorePath=FULL_PATH_TO_Fika.Core.dll." />
  </Target>
</Project>
